# Production environment variable — set this in the Vercel project settings
# (Settings → Environment Variables), not in a committed file. Vite only
# inlines import.meta.env.* at build time, so changing this value requires a
# redeploy, not just an env var update.
#
# Bare backend origin — no trailing slash, no /api suffix. The frontend
# appends /api itself (see src/api/client.ts).
VITE_API_URL=https://school-management-backend-1t21.onrender.com
