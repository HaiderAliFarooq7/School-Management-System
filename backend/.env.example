DATABASE_URL=postgresql+psycopg://sms_user:sms_pass@localhost:5432/sms_db
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
PG_BIN_DIR=C:\Program Files\PostgreSQL\18\bin

# WhatsApp Cloud API (Communication Module). Never stored in the database —
# read only from here. Leave blank until you have a Meta developer app +
# WhatsApp Business number; the WhatsApp Cloud provider just reports
# "disconnected" until these are set.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_GRAPH_VERSION=v25.0
# true only once your attendance_absent/pending_fee/custom_message templates
# are approved in the Meta dashboard — otherwise messages outside the 24h
# customer-service window will fail.
WHATSAPP_USE_TEMPLATES=false
