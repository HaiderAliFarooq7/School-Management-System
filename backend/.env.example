# Production environment variables — set these in the Render dashboard
# (Service → Environment), not in a committed file. This example exists only
# to document what's required; the app reads exclusively from real
# environment variables (no .env file is loaded at runtime).

# Required. Neon PostgreSQL connection string (Dashboard → Connection Details).
# Accepted as-is, or as postgres://... / postgresql://... — all are
# normalized to the psycopg v3 driver automatically.
DATABASE_URL=postgresql://user:password@ep-example-000000.us-east-2.aws.neon.tech/sms_db?sslmode=require

# Required. Long random string used to sign JWTs.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-string-from-secrets

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Required. Comma-separated list of allowed frontend origins — the Vercel
# production domain, plus any custom domain.
CORS_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# Optional. Only set this if pg_dump/pg_restore are not already on PATH.
PG_BIN_DIR=

# Optional. Directory for the school logo and student photos. Without a
# Render persistent disk attached, this defaults to an ephemeral path and
# uploads are lost on every restart/deploy. If you attach a persistent disk
# mounted at /var/data, set this to /var/data/sms to make uploads durable.
DATA_DIR=

# ---------------------------------------------------------------------------
# Multi-tenant (master database)
# ---------------------------------------------------------------------------
# Optional. The master (control-plane) database that stores school routing,
# the super admin, and the user/parent directories. Defaults to a sibling
# database named 'sms_master' on the same PostgreSQL host as DATABASE_URL, so
# no value is needed unless the master DB lives elsewhere.
MASTER_DATABASE_URL=

# ---------------------------------------------------------------------------
# Parent module — Firebase Cloud Messaging (push to the parent Android app)
# ---------------------------------------------------------------------------
# Optional. The parent module works fully without Firebase (login, data,
# notification history all function) — only push delivery is skipped when
# unset. NEVER commit real credentials; set them in the Render dashboard, or
# drop the service-account file at backend/firebase/service-account.json
# (git-ignored). Provide EITHER the inline JSON (preferred on Render) OR a path.
#
# The service-account JSON, inline on one line (Firebase Console → Project
# Settings → Service accounts → Generate new private key).
FIREBASE_CREDENTIALS_JSON=
# Alternative: absolute path to the service-account JSON file. Leave blank if
# using FIREBASE_CREDENTIALS_JSON or the default backend/firebase/ file.
FIREBASE_CREDENTIALS_FILE=
# Optional. Parent app JWT lifetime in minutes (default 43200 = 30 days).
PARENT_JWT_EXPIRE_MINUTES=43200
